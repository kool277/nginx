#!/usr/bin/perl

# Regression test: object paths generated by auto/make must not be
# corrupted when --builddir contains a source suffix such as ".c" or ".S".

# Before the fix, the chained sed substitutions in auto/make re-matched
# the build directory inside already translated object paths, producing
# targets like "objs.c//abs/objs.o/src/misc/ngx_cpp_test_module.o".

###############################################################################

use warnings;
use strict;

use Test::More;

use File::Temp qw/ tempdir /;
use Cwd qw/ abs_path /;
use FindBin;

###############################################################################

my $src = abs_path("$FindBin::Bin/../..");

plan(skip_all => 'no auto/configure') unless -x "$src/auto/configure";
plan(skip_all => 'no make') if system('command -v make >/dev/null 2>&1');

plan(tests => 4);

###############################################################################

# configure writes a Makefile into the current directory,
# so work on a copy of the build system

my $d = tempdir('nginx-regress-XXXXXXXXXX', TMPDIR => 1, CLEANUP => 1);

system("cp -R $src/auto $src/src $src/conf $d/") == 0
	or die "cp failed: $!\n";
system("mkdir -p $d/html && cp -R $src/docs/html/. $d/html/ 2>/dev/null");

# a minimal dynamic module

mkdir "$d/addon";
open my $fh, '>', "$d/addon/config" or die "$!\n";
print $fh <<'EOF';
ngx_addon_name=ngx_regress_module
ngx_module_type=CORE
ngx_module_name=ngx_regress_module
ngx_module_srcs="$ngx_addon_dir/ngx_regress_module.c"
. auto/module
EOF
close $fh;

open $fh, '>', "$d/addon/ngx_regress_module.c" or die "$!\n";
print $fh <<'EOF';
#include <ngx_config.h>
#include <ngx_core.h>

ngx_module_t  ngx_regress_module = {
    NGX_MODULE_V1, NULL, NULL, NGX_CORE_MODULE,
    NULL, NULL, NULL, NULL, NULL, NULL, NULL,
    NGX_MODULE_V1_PADDING
};
EOF
close $fh;

for my $sfx ('.c', '.S') {
	my $b = "$d/build$sfx-dir";

	my $out = `cd $d && sh auto/configure --builddir=$b \\
		--without-http_rewrite_module --without-http_gzip_module \\
		--with-cpp_test_module --with-compat \\
		--add-dynamic-module=$d/addon 2>&1`;

	if ($?) {
		fail("configure with builddir \"$sfx\"") for 1 .. 2;
		diag($out);
		next;
	}

	$out = `cd $d && make -n -f $b/Makefile binary modules 2>&1`;
	ok($? == 0 && $out !~ /No rule to make target/,
		"object paths with builddir \"$sfx\"")
		or diag(join "\n", grep { /No rule/ } split /\n/, $out);

	open my $mk, '<', "$b/Makefile" or die "$!\n";
	my $makefile = join '', <$mk>;
	close $mk;

	# a corrupted path is the builddir prefixed to another absolute path

	my $twice = () = $makefile =~ /\Q$b\E\/\//g;
	is($twice, 0, "builddir not doubled with \"$sfx\"");
}

###############################################################################
